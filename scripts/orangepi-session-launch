#!/usr/bin/env bash
set -Eeuo pipefail

PROFILE=${1:?session profile required}
import_later() {
    systemctl --user import-environment \
        DISPLAY XAUTHORITY WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
        SWAYSOCK 2>/dev/null || true
}
start_wayvnc() {
    local state_log wayvnc_bin runtime socket
    state_log="${XDG_STATE_HOME:-$HOME/.local/state}/orangepi-zero3w-setup-wayvnc.log"
    mkdir -p "$(dirname "$state_log")"
    {
        printf 'Starting WayVNC session hook at %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'HOME=%s XDG_RUNTIME_DIR=%s WAYLAND_DISPLAY=%s PATH=%s\n' \
            "$HOME" "${XDG_RUNTIME_DIR:-}" "${WAYLAND_DISPLAY:-}" "$PATH"
    } >>"$state_log" 2>&1
    if [[ ! -f "$HOME/.config/orangepi-zero3w-setup/wayvnc-enabled" ]]; then
        printf 'WayVNC is not enabled for this user.\n' >>"$state_log"
        return 0
    fi
    wayvnc_bin=$(command -v wayvnc 2>/dev/null || true)
    if [[ -z $wayvnc_bin ]]; then
        printf 'WayVNC executable was not found in PATH.\n' >>"$state_log"
        return 0
    fi
    (
        runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
        for _ in {1..60}; do
            socket=$(find "$runtime" -maxdepth 1 -type s -name 'wayland-*' -print -quit 2>/dev/null || true)
            if [[ -n $socket ]]; then
                export XDG_RUNTIME_DIR="$runtime"
                export WAYLAND_DISPLAY=${socket##*/}
                printf 'Starting %s with XDG_RUNTIME_DIR=%s WAYLAND_DISPLAY=%s\n' \
                    "$wayvnc_bin" "$XDG_RUNTIME_DIR" "$WAYLAND_DISPLAY"
                exec "$wayvnc_bin" --config "$HOME/.config/wayvnc/config"
            fi
            sleep 1
        done
        printf 'Wayland socket was not found under %s after 60 seconds.\n' "$runtime"
    ) >"$state_log" 2>&1 &
}

case "$PROFILE" in
    xfce)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE
        import_later
        exec startxfce4
        ;;
    openbox)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=Openbox
        import_later
        exec openbox-session
        ;;
    i3)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=i3
        import_later
        exec i3
        ;;
    icewm)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=IceWM
        import_later
        if command -v icewm-session >/dev/null 2>&1; then
            exec icewm-session
        fi
        exec icewm
        ;;
    fluxbox)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=Fluxbox
        import_later
        exec startfluxbox
        ;;
    sway)
        export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway
        start_wayvnc
        exec sway
        ;;
    labwc)
        export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=labwc
        start_wayvnc
        exec labwc
        ;;
    enlightenment-x11)
        export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=Enlightenment
        import_later
        exec enlightenment_start
        ;;
    enlightenment-wayland)
        export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Enlightenment
        exec enlightenment_start
        ;;
    *)
        echo "Unknown session profile: $PROFILE" >&2
        exit 2
        ;;
esac
