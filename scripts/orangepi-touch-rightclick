#!/usr/bin/env python3
# Purpose: Emit a right-click when a single-touch panel press is held still,
#   firing on lift so the pending press completes before the menu opens.
# Platform: Board-side Linux with python3-evdev; input layer only, so it works
#   under both X11 and Wayland compositors (unlike X11-only helpers).
# Inputs: --device-name (substring match on the input device, default WS170120),
#   --backend (uinput: kernel injection, X11+Wayland but needs /dev/uinput;
#   xtest: X11 XTEST injection, no kernel support needed, X11 sessions only),
#   --display/--xauthority (xtest backend addressing, default :0 and the
#   LightDM root authority when present),
#   --gesture (hold: press-and-hold fires on lift; tap-hold: quick tap
#   followed by a held press fires on lift, leaving a plain long-press free
#   for drag/select),
#   --hold-ms (hold deadline, default 500), --tap-window-ms (max gap between
#   the tap and the held press in tap-hold mode, default 400),
#   --tap-ms (max two-finger chord for a two-finger tap, default 300, needs
#   ABS_MT_SLOT support, 0 disables), --move-units
#   (jitter allowance in device ABS units, default 12), --uinput-name,
#   --self-test.
# Writes: No files. Creates a transient uinput pointer device that only emits
#   BTN_RIGHT press/release at the current cursor position; the watched touch
#   device is opened read-only and never grabbed, so killing this daemon
#   restores plain touch behavior immediately.
# Safety: Runs as root under systemd to read /dev/input/event* and /dev/uinput.
#   Never reboots, never touches boot ordering, never alters the GPU stack.
# Repeat behavior: Safe to restart; re-scans for the touch device when the USB
#   panel is unplugged (2 s retry).
# Recovery: sudo systemctl disable --now touch-rightclick.service (or the
#   board-touch-rightclick-uninstall Make target); touch input is unaffected.
# Verification: scripts/orangepi-touch-rightclick --self-test (no hardware or
#   root needed); on the board, hold a finger still, lift, and watch the
#   context menu appear with the next tap selecting normally.
# Documentation: docs/optional/touch-rightclick.md
# Known limitation: the press itself still reaches the stack as a left-press
#   (this daemon observes without grabbing, by design). The click fires on
#   lift so that press completes first and the menu opens with no buttons
#   down; firing mid-hold instead would leave a dangling press whose release
#   dismisses the menu or triggers the item under the finger. Single-touch
#   eGalax-style panels report no multi-touch slots, so two-finger gestures
#   are impossible on them.
"""Long-press-to-right-click daemon for single-touch Waveshare panels."""
import argparse
import os
import select
import sys
import time


def _parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Hold a finger still on the touchscreen, then lift, to right-click."
    )
    parser.add_argument("--device-name", default="WS170120",
                        help="Substring matched against the input device name.")
    parser.add_argument("--backend", choices=("uinput", "xtest"), default="uinput",
                        help="uinput: inject through the kernel (X11 and Wayland, "
                             "needs /dev/uinput). xtest: inject through the X11 "
                             "XTEST extension (no kernel support needed, but X11 "
                             "sessions only).")
    parser.add_argument("--display", default=":0",
                        help="X display addressed by the xtest backend.")
    parser.add_argument("--xauthority", default=None,
                        help="Xauthority file for the xtest backend; defaults to "
                             "the LightDM root authority when present.")
    parser.add_argument("--gesture", choices=("hold", "tap-hold"), default="hold",
                        help="hold: press-and-hold-still fires (default). "
                             "tap-hold: a quick tap followed by a held press "
                             "fires, leaving a plain long-press free for "
                             "drag/select gestures.")
    parser.add_argument("--hold-ms", type=int, default=500,
                        help="Hold deadline in milliseconds; lifting after it fires.")
    parser.add_argument("--tap-window-ms", type=int, default=400,
                        help="In tap-hold mode, max gap in milliseconds between "
                             "the tap lift and the held press.")
    parser.add_argument("--tap-ms", type=int, default=300,
                        help="Max two-finger chord length in milliseconds for a "
                             "two-finger tap (needs ABS_MT_SLOT support; 0 "
                             "disables the gesture).")
    parser.add_argument("--move-units", type=int, default=12,
                        help="Movement allowance in ABS device units; larger "
                             "motion cancels the pending right-click.")
    parser.add_argument("--uinput-name", default="orangepi-touch-rightclick",
                        help="Name of the transient uinput injector device.")
    parser.add_argument("--rescan-seconds", type=float, default=2.0,
                        help="Delay before re-scanning after device loss.")
    parser.add_argument("--debug", action="store_true",
                        help="Log every press/lift/arm/cancel decision to the journal.")
    parser.add_argument("--self-test", action="store_true",
                        help="Run the deterministic hold-detector checks and exit.")
    return parser.parse_args(argv)


class HoldDetector:
    """Pure hold-to-right-click state machine (no I/O, unit-testable).

    The right-click fires on LIFT, not at the deadline: the press must stay
    down and inside the movement allowance past the deadline, and the pending
    press must complete first. Firing mid-hold leaves a dangling press whose
    release toolkits pair with the lift, dismissing the just-opened menu or
    instantly triggering the item under the finger. on_fire is therefore
    called at most once per press, from touch_up().
    """

    IDLE, PRESSING, ARMED, MOVED = ("idle", "pressing", "armed", "moved")

    def __init__(self, hold_ms, move_units, on_fire,
                 gesture="hold", tap_window_ms=400, log=None):
        self.hold_ms = hold_ms
        self.move_units = move_units
        self.on_fire = on_fire
        self.gesture = gesture
        self.tap_window_ms = tap_window_ms
        self.log = log or (lambda *a: None)
        self.state = self.IDLE
        self.anchor = (0, 0)
        self.deadline = 0
        self.last_lift_ms = None

    def _moved(self, x, y):
        return (abs(x - self.anchor[0]) > self.move_units
                or abs(y - self.anchor[1]) > self.move_units)

    def _armed(self, now_ms):
        if self.gesture == "hold":
            return True
        return (self.last_lift_ms is not None
                and now_ms - self.last_lift_ms <= self.tap_window_ms)

    def touch_down(self, now_ms, x, y):
        if self.state == self.IDLE and self._armed(now_ms):
            self.state = self.PRESSING
            self.anchor = (x, y)
            self.deadline = now_ms + self.hold_ms
            self.log("hold: press at (%d,%d), arming for %d ms"
                     % (x, y, self.hold_ms))
        elif self.state == self.IDLE:
            self.log("hold: press ignored (tap-hold window missed)")

    def touch_up(self, now_ms=None):
        """End the press. Returns True when a right-click should fire: the
        press outlasted the deadline without wandering (ARMED)."""
        fire = self.state == self.ARMED
        if self.state == self.PRESSING:
            self.log("hold: lift after %d ms, too early (need %d)"
                     % (now_ms - (self.deadline - self.hold_ms)
                        if now_ms is not None else -1, self.hold_ms))
        elif self.state == self.MOVED:
            self.log("hold: lift after wandering, cancelled")
        elif self.state == self.IDLE:
            self.log("hold: lift with no pending press")
        if self.state in (self.PRESSING, self.ARMED, self.MOVED):
            self.state = self.IDLE
        if now_ms is not None:
            self.last_lift_ms = now_ms
        if fire:
            self.on_fire()
        return fire

    def reset(self):
        """Forget a press without firing (device loss)."""
        self.state = self.IDLE

    def position(self, x, y):
        if self.state in (self.PRESSING, self.ARMED):
            dx = abs(x - self.anchor[0])
            dy = abs(y - self.anchor[1])
            if self._moved(x, y):
                self.log("hold: drift (%d,%d) past allowance %d, cancelled"
                         % (dx, dy, self.move_units))
                self.state = self.MOVED

    def poll(self, now_ms):
        """Call on every loop iteration; arms the press once the deadline
        passes (no firing here). Returns seconds until the deadline
        (0.0 when already due) or None when no press is pending."""
        if self.state != self.PRESSING:
            return None
        remaining_ms = self.deadline - now_ms
        if remaining_ms <= 0:
            self.state = self.ARMED
            self.log("hold: deadline passed, armed; lift to fire")
            return None
        return remaining_ms / 1000.0


class TwoFingerTapDetector:
    """Pure two-finger-tap state machine (no I/O, unit-testable).

    Tracks multitouch slots: exactly two contacts that appear together, stay
    within the movement allowance, and both lift within tap_ms fire one
    right-click on the final lift. Anything else (single finger, three or
    more contacts, dragging, lingering) never fires. A chord runs from the
    first contact down to the last lift.
    """

    def __init__(self, tap_ms, move_units, on_fire, log=None):
        self.tap_ms = tap_ms
        self.move_units = move_units
        self.on_fire = on_fire
        self.log = log or (lambda *a: None)
        self.active = {}  # slot -> [x0, y0, x, y, t0, positioned]
        self.max_concurrent = 0
        self.chord_start = 0
        self.moved = False

    def _check_move(self, slot):
        contact = self.active[slot]
        if (abs(contact[2] - contact[0]) > self.move_units
                or abs(contact[3] - contact[1]) > self.move_units):
            if not self.moved:
                self.log("tap: slot %d drifted past allowance, chord spoiled"
                         % slot)
            self.moved = True

    def contact(self, slot, tracking_id, x, y, now_ms):
        """Feed an ABS_MT_SLOT/TRACKING_ID observation for one slot. The
        coordinates cached at ID time may predate the contact (position
        events arrive separately), so the anchor is set by the first real
        position event, not here."""
        if tracking_id == -1:
            if slot in self.active:
                del self.active[slot]
            if not self.active:
                self._end_chord(now_ms)
            return
        if slot not in self.active:
            if not self.active:
                self.chord_start = now_ms
                self.moved = False
            self.active[slot] = [x, y, x, y, now_ms, False]
            if len(self.active) > self.max_concurrent:
                self.max_concurrent = len(self.active)
        elif self.active[slot][5]:
            self.active[slot][2] = x
            self.active[slot][3] = y
            self._check_move(slot)

    def position(self, slot, x, y):
        if slot in self.active:
            contact = self.active[slot]
            if not contact[5]:
                contact[0] = x
                contact[1] = y
                contact[5] = True
            contact[2] = x
            contact[3] = y
            self._check_move(slot)

    def concurrent(self):
        return len(self.active)

    def _end_chord(self, now_ms):
        duration = now_ms - self.chord_start
        fire = (self.max_concurrent == 2 and not self.moved
                and 0 <= duration <= self.tap_ms)
        self.log("tap: chord ended: contacts=%d moved=%s duration=%dms -> %s"
                 % (self.max_concurrent, self.moved, duration,
                    "FIRE" if fire else "ignore"))
        self.max_concurrent = 0
        self.moved = False
        if fire:
            self.on_fire()

    def reset(self):
        self.active = {}
        self.max_concurrent = 0
        self.moved = False


def run_self_test():
    failures = []

    def check(name, condition):
        print(("PASS " if condition else "FAIL ") + name)
        if not condition:
            failures.append(name)

    # 1. Short tap: no fire.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    det.touch_down(0, 100, 100)
    det.poll(200)
    check("short tap does not fire", det.touch_up(300) is False and fired == [])

    # 2. Hold still past the deadline: nothing fires mid-hold; the lift fires
    # exactly once; a second lift fires nothing.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    det.touch_down(0, 100, 100)
    det.position(103, 99)  # jitter inside the allowance
    check("deadline pending before hold elapses", det.poll(500) is not None)
    det.poll(700)
    check("no mid-hold fire after the deadline", fired == [])
    check("lift after hold fires once", det.touch_up(900) is True and fired == [1])
    check("second lift fires nothing", det.touch_up(950) is False and fired == [1])

    # 3. Drag past the allowance cancels.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    det.touch_down(0, 100, 100)
    det.position(200, 100)
    det.poll(5000)
    check("drag cancels the pending fire", det.touch_up(5100) is False and fired == [])

    # 4. Wandering after arming cancels too.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    det.touch_down(0, 100, 100)
    det.poll(700)
    det.position(500, 500)
    check("post-arm motion cancels", det.touch_up(900) is False and fired == [])

    # 5. Stray lift with no press is harmless.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    check("stray lift is harmless", det.touch_up(9999) is False
          and det.poll(19999) is None and fired == [])

    # 6. tap-hold mode: quick tap followed by a held press fires on lift.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1),
                       gesture="tap-hold", tap_window_ms=400)
    det.touch_down(0, 100, 100)
    det.touch_up(120)
    det.touch_down(300, 102, 101)
    det.poll(1100)
    check("tap-hold fires on lift of the held press",
          det.touch_up(1200) is True and fired == [1])

    # 7. tap-hold mode: a plain long-press without the leading tap is ignored,
    # leaving it free for drag/select gestures.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1),
                       gesture="tap-hold", tap_window_ms=400)
    det.touch_down(5000, 100, 100)
    det.poll(9000)
    check("tap-hold ignores a plain long-press",
          det.touch_up(9100) is False and fired == [])

    # 8. tap-hold mode: a stale tap outside the window does not arm.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1),
                       gesture="tap-hold", tap_window_ms=400)
    det.touch_down(0, 100, 100)
    det.touch_up(120)
    det.touch_down(2000, 100, 100)
    det.poll(4000)
    check("tap-hold ignores a stale leading tap",
          det.touch_up(4100) is False and fired == [])

    # 9. tap-hold mode: a quick double-tap (no hold) fires nothing.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1),
                       gesture="tap-hold", tap_window_ms=400)
    det.touch_down(0, 100, 100)
    det.touch_up(100)
    det.touch_down(200, 100, 100)
    check("tap-hold ignores a quick double-tap",
          det.touch_up(300) is False and fired == [])

    # 10. Device loss mid-hold resets without firing.
    fired = []
    det = HoldDetector(700, 12, lambda: fired.append(1))
    det.touch_down(0, 100, 100)
    det.poll(900)
    det.reset()
    check("device loss resets without firing",
          det.touch_up(950) is False and fired == [])

    # 11. Two-finger quick tap fires once on the final lift.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 0, 0, 0)
    tap.position(0, 100, 100)
    tap.contact(1, 11, 0, 0, 40)
    tap.position(1, 200, 200)
    tap.contact(0, -1, 100, 100, 120)
    tap.contact(1, -1, 200, 200, 150)
    check("two-finger tap fires once", fired == [1])

    # 12. Single-finger tap never fires the two-finger detector.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 100, 100, 0)
    tap.contact(0, -1, 100, 100, 120)
    check("single tap does not fire two-finger tap", fired == [])

    # 13. Lingering two-finger hold does not fire.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 100, 100, 0)
    tap.contact(1, 11, 200, 200, 40)
    tap.contact(0, -1, 100, 100, 900)
    tap.contact(1, -1, 200, 200, 950)
    check("two-finger hold does not fire", fired == [])

    # 14. Two-finger drag does not fire.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 0, 0, 0)
    tap.position(0, 100, 100)
    tap.contact(1, 11, 0, 0, 20)
    tap.position(1, 200, 200)
    tap.position(0, 160, 100)
    tap.contact(0, -1, 160, 100, 120)
    tap.contact(1, -1, 200, 200, 140)
    check("two-finger drag does not fire", fired == [])

    # 15. Three fingers never fire.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 100, 100, 0)
    tap.contact(1, 11, 200, 200, 20)
    tap.contact(2, 12, 300, 300, 40)
    tap.contact(0, -1, 100, 100, 120)
    tap.contact(1, -1, 200, 200, 130)
    tap.contact(2, -1, 300, 300, 140)
    check("three fingers do not fire", fired == [])

    # 16. A second two-finger tap after the first fires again.
    fired = []
    tap = TwoFingerTapDetector(300, 12, lambda: fired.append(1))
    tap.contact(0, 10, 100, 100, 0)
    tap.contact(1, 11, 200, 200, 20)
    tap.contact(0, -1, 100, 100, 100)
    tap.contact(1, -1, 200, 200, 120)
    tap.contact(0, 20, 100, 100, 1000)
    tap.contact(1, 21, 200, 200, 1020)
    tap.contact(0, -1, 100, 100, 1100)
    tap.contact(1, -1, 200, 200, 1120)
    check("repeat two-finger taps fire each time", fired == [1, 1])

    if failures:
        print("%d self-test failure(s)." % len(failures), file=sys.stderr)
        return 1
    print("All hold-detector self-tests passed.")
    return 0


def find_touch_device(evdev, name_substring):
    from evdev import ecodes
    for path in evdev.list_devices():
        try:
            device = evdev.InputDevice(path)
        except OSError:
            continue
        if name_substring.lower() not in device.name.lower():
            device.close()
            continue
        caps = device.capabilities()
        abs_caps = caps.get(ecodes.EV_ABS, [])
        axes = {code for code, _ in abs_caps}
        if ecodes.ABS_X in axes and ecodes.ABS_Y in axes:
            return device
        device.close()
    return None


def make_uinput_emitter(args):
    """Right-click injector through the kernel uinput device.

    Works under X11 and Wayland but needs /dev/uinput (the uinput module).
    Returns the emit callable, or None when unavailable."""
    from evdev import ecodes, UInput
    try:
        injector = UInput({ecodes.EV_KEY: [ecodes.BTN_RIGHT],
                           ecodes.EV_REL: [ecodes.REL_X, ecodes.REL_Y]},
                          name=args.uinput_name)
    except OSError as exc:
        print("ERROR: cannot create the uinput injector (%s). Load the uinput "
              "module or rerun with --backend xtest on X11." % exc,
              file=sys.stderr)
        return None
    print("uinput injector ready as '%s'." % args.uinput_name, flush=True)

    def emit():
        injector.write(ecodes.EV_KEY, ecodes.BTN_RIGHT, 1)
        injector.syn()
        time.sleep(0.03)
        injector.write(ecodes.EV_KEY, ecodes.BTN_RIGHT, 0)
        injector.syn()
        print("right-click emitted.", flush=True)

    return emit


LIGHTDM_ROOT_AUTH = "/var/run/lightdm/root/:0"
STATE_USER_FILE = "/etc/orangepi-zero3w-setup/state/user"


def _auth_candidates(args):
    """Readable, non-empty X authority files, best first: explicit flag,
    LightDM root authority, then the recorded login user's authority."""
    paths = []
    if args.xauthority:
        paths.append(args.xauthority)
    paths.append(LIGHTDM_ROOT_AUTH)
    try:
        with open(STATE_USER_FILE) as f:
            user = f.read().strip()
        if user and "/" not in user:
            paths.append("/home/%s/.Xauthority" % user)
    except OSError:
        pass
    seen = set()
    usable = []
    for path in paths:
        if path in seen:
            continue
        seen.add(path)
        try:
            if os.path.getsize(path) > 0:
                usable.append(path)
        except OSError:
            continue
    return usable


def _display_candidates(args):
    """Configured display first, then any other live X sockets (covers the
    :0/:1 shuffle when a greeter and a session coexist)."""
    displays = [args.display]
    try:
        names = sorted(os.listdir("/tmp/.X11-unix"))
    except OSError:
        names = []
    for name in names:
        if name.startswith("X") and name[1:].isdigit():
            disp = ":" + name[1:]
            if disp not in displays:
                displays.append(disp)
    return displays


def make_xtest_emitter(args):
    """Right-click injector through the X11 XTEST extension.

    Needs no kernel support, but only reaches X11 sessions (never Wayland).
    The daemon runs as root, so it uses the LightDM root authority for the
    autologin display by default. Returns the emit callable, or None when
    python3-xlib is missing."""
    try:
        from Xlib import X
        from Xlib import display as xdisplay
    except ImportError:
        print("ERROR: python3-xlib is required for --backend xtest "
              "(sudo apt install -y python3-xlib).", file=sys.stderr)
        return None
    auth = args.xauthority
    if auth is None and os.path.exists(LIGHTDM_ROOT_AUTH):
        auth = LIGHTDM_ROOT_AUTH
    if auth is not None:
        os.environ["XAUTHORITY"] = auth
    os.environ["DISPLAY"] = args.display
    state = {"display": None}

    def connect():
        # python-xlib connects lazily: construction alone does not prove the
        # authority works, so force a round-trip to validate each combo.
        if state["display"] is not None:
            return state["display"]
        last_exc = Exception("no usable display/authority combination found")
        for disp in _display_candidates(args):
            for auth_path in _auth_candidates(args):
                os.environ["XAUTHORITY"] = auth_path
                try:
                    candidate = xdisplay.Display(disp)
                    candidate.sync()
                except Exception as exc:
                    last_exc = exc
                    try:
                        candidate.close()
                    except Exception:
                        pass
                    continue
                state["display"] = candidate
                print("xtest connected to display '%s' (%s)."
                      % (disp, auth_path), flush=True)
                return candidate
        raise last_exc

    print("xtest injector ready for display '%s'." % args.display, flush=True)

    def emit():
        try:
            disp = connect()
            disp.xtest_fake_input(X.ButtonPress, 3)
            disp.sync()
            time.sleep(0.03)
            disp.xtest_fake_input(X.ButtonRelease, 3)
            disp.sync()
        except Exception as exc:
            print("xtest emit failed (%s); will retry on the next hold."
                  % exc, flush=True)
            try:
                state["display"].close()
            except Exception:
                pass
            state["display"] = None
        else:
            print("right-click emitted.", flush=True)

    return emit


def run_daemon(args):
    try:
        import evdev
        from evdev import ecodes
    except ImportError:
        print("ERROR: python3-evdev is required "
              "(sudo apt install -y python3-evdev).", file=sys.stderr)
        return 2

    if args.backend == "xtest":
        emit_right_click = make_xtest_emitter(args)
        if emit_right_click is None:
            return 2
    else:
        emit_right_click = make_uinput_emitter(args)
        if emit_right_click is None:
            return 2

    from evdev import ecodes
    if args.debug:
        def dlog(msg):
            print("debug: %s" % msg, flush=True)
    else:
        def dlog(*a):
            pass
    detector = HoldDetector(args.hold_ms, args.move_units, emit_right_click,
                           gesture=args.gesture,
                           tap_window_ms=args.tap_window_ms, log=dlog)
    tap_detector = TwoFingerTapDetector(args.tap_ms, args.move_units,
                                       emit_right_click, log=dlog)
    device = None
    multitouch = False
    x = y = 0
    touching = False
    current_slot = 0
    slot_pos = {}
    multi_seen = False

    while True:
        if device is None:
            device = find_touch_device(evdev, args.device_name)
            if device is None:
                time.sleep(args.rescan_seconds)
                continue
            print("watching '%s' (%s)." % (device.name, device.path), flush=True)
            abs_codes = {code for code, _ in
                         device.capabilities().get(ecodes.EV_ABS, [])}
            multitouch = (args.tap_ms > 0
                          and ecodes.ABS_MT_SLOT in abs_codes
                          and ecodes.ABS_MT_TRACKING_ID in abs_codes)
            print("two-finger tap %s." % ("enabled" if multitouch else "disabled"),
                  flush=True)
            x = y = 0
            touching = False
            current_slot = 0
            slot_pos = {}
            multi_seen = False
            detector.reset()
            tap_detector.reset()
        now_ms = int(time.monotonic() * 1000)
        timeout = detector.poll(now_ms)
        try:
            ready, _, _ = select.select([device], [], [], timeout)
        except (OSError, ValueError):
            device = None
            detector.reset()
            tap_detector.reset()
            continue
        if not ready:
            continue  # select timed out exactly at the deadline; loop re-polls.
        try:
            for event in device.read():
                if event.type == ecodes.EV_ABS:
                    if event.code == ecodes.ABS_X:
                        x = event.value
                    elif event.code == ecodes.ABS_Y:
                        y = event.value
                    elif multitouch and event.code == ecodes.ABS_MT_SLOT:
                        current_slot = event.value
                        slot_pos.setdefault(current_slot, [0, 0])
                    elif multitouch and event.code == ecodes.ABS_MT_TRACKING_ID:
                        pos = slot_pos.setdefault(current_slot, [0, 0])
                        tap_detector.contact(current_slot, event.value,
                                             pos[0], pos[1],
                                             int(time.monotonic() * 1000))
                        if tap_detector.concurrent() >= 2 and not multi_seen:
                            # Two live contacts: this is not a single-finger
                            # hold, so disarm it; the tap detector owns the chord.
                            multi_seen = True
                            detector.reset()
                    elif multitouch and event.code == ecodes.ABS_MT_POSITION_X:
                        slot_pos.setdefault(current_slot, [0, 0])[0] = event.value
                        tap_detector.position(current_slot, event.value,
                                              slot_pos[current_slot][1])
                    elif multitouch and event.code == ecodes.ABS_MT_POSITION_Y:
                        slot_pos.setdefault(current_slot, [0, 0])[1] = event.value
                        tap_detector.position(current_slot,
                                              slot_pos[current_slot][0],
                                              event.value)
                    if touching:
                        detector.position(x, y)
                elif event.type == ecodes.EV_KEY and event.code == ecodes.BTN_TOUCH:
                    if event.value:
                        touching = True
                        detector.touch_down(int(time.monotonic() * 1000), x, y)
                    else:
                        touching = False
                        multi_seen = False
                        detector.touch_up(int(time.monotonic() * 1000))
        except OSError:
            print("touch device lost; re-scanning.", flush=True)
            try:
                device.close()
            except OSError:
                pass
            device = None
            detector.reset()
            tap_detector.reset()


def main(argv=None):
    args = _parse_args(sys.argv[1:] if argv is None else argv)
    if args.self_test:
        return run_self_test()
    if args.hold_ms <= 0 or args.move_units < 0 or args.tap_window_ms <= 0:
        print("ERROR: --hold-ms and --tap-window-ms must be positive and "
              "--move-units non-negative.", file=sys.stderr)
        return 2
    if args.tap_ms < 0:
        print("ERROR: --tap-ms must be non-negative (0 disables two-finger tap).",
              file=sys.stderr)
        return 2
    return run_daemon(args)


if __name__ == "__main__":
    sys.exit(main())
